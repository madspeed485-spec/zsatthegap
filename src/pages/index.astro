---
import { Image, getImage } from 'astro:assets';
import { event } from '../config';
import hero from '../images/hero.png';
import dragon from '../images/dragon-129.png';
import us129 from '../images/us129-dragon.png';
const galleryModules = import.meta.glob<{ default: ImageMetadata }>('../images/gallery/*.{jpg,jpeg,png,webp}', { eager: true });
const ordered = [
  '../images/gallery/z350-dragon-curve.jpg',
  '../images/gallery/z350-dragon-statue.jpg',
  '../images/gallery/nismo-z-side.jpg',
  '../images/gallery/us129-north-sign.jpg',
];
const rest = Object.keys(galleryModules).filter((path) => !ordered.includes(path)).sort();
const imgs = [...rest, ...ordered].map((path) => galleryModules[path].default);
const gallery = [hero, ...imgs];
const photos = await Promise.all(gallery.map(async (src) => {
  const large = await getImage({ src, width: 2400 });
  return { src, full: large.src };
}));
const fbIcon = `<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M24 12a12 12 0 1 0-13.9 11.9v-8.4H7.1V12h3V9.4c0-3 1.8-4.7 4.5-4.7 1.3 0 2.7.2 2.7.2v3h-1.5c-1.5 0-2 .9-2 1.9V12h3.4l-.5 3.5h-2.9v8.4A12 12 0 0 0 24 12z"/></svg>`;
---
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" href="/favicon.svg" />
<title>{event.name} | Yearly Nissan Z Gathering at the Tail of the Dragon</title>
<meta name="description" content={`${event.name}: the yearly Nissan Z car event at the Tail of the Dragon, Deals Gap.`} />
</head>
<body>
<nav><a href="#top" class="brand">Zs<span>@</span>the Gap</a><div><a href="#event">Event</a><a href="#stay">Stay</a><a href="#gallery">Gallery</a><a href="#contact">Contact</a><a class="fb" href={event.facebookUrl} target="_blank" rel="noopener" aria-label="Facebook group" set:html={fbIcon} /></div></nav>
<div class="banner"><Image src={hero} alt="Z at the Gap, Fontana Village, Oct 1-3, 2027" widths={[600, 900, 1200, 1600, 1920, 2400]} sizes="100vw" loading="eager" fetchpriority="high" /></div>
<header id="top" class="hero">
  <p class="kicker">Nissan Z · 318 curves · one weekend</p>
  <h1>{event.name}</h1>
  <div class="hero-mid">
    <Image src={dragon} alt="Tail of the Dragon US 129" widths={[100, 170, 340]} sizes="(max-width: 600px) 100px, 170px" class="dragon" />
    <div class="hero-copy">
      <p class="tagline">{event.tagline}</p>
      <p class="when">{event.displayDate} · {event.displayTime}</p>
      <p>{event.location}</p>
    </div>
    <Image src={us129} alt="US 129 dragon" widths={[100, 170, 340]} sizes="(max-width: 600px) 100px, 170px" class="us129" />
  </div>
  <div id="countdown" data-date={event.dateISO}>
    <div><b id="d">--</b><small>Days</small></div><div><b id="h">--</b><small>Hours</small></div>
    <div><b id="m">--</b><small>Min</small></div><div><b id="s">--</b><small>Sec</small></div>
  </div>
  <a class="btn" href="#stay">Book your stay</a>
</header>
<main>
<section id="event"><h2>The Event</h2>
<p>{event.name} is our yearly Nissan Z car gathering at the legendary <a href={event.dragonUrl} target="_blank" rel="noopener">Tail of the Dragon</a> at Deals Gap, 318 curves in 11 miles on US 129 along the Great Smoky Mountains. Bring your Z, from classic 240Zs to the latest Nissan Z, cruise the Dragon, show off your build, and hang out with fellow Z enthusiasts.</p></section>
<section id="stay" class="alt"><h2>Book Your Stay</h2>
<p>We've got a hotel block at <strong>{event.hotelName}</strong>. Book early, rooms near the Gap go fast.</p>
<p>Block dates: <strong>{event.hotelBlockDates}</strong> · Group code: <strong>{event.hotelGroupCode}</strong> (already applied by the button below)</p>
<a class="btn" href={event.hotelUrl} target="_blank" rel="noopener">Book at {event.hotelName}</a></section>
<section id="gallery"><h2>Gallery</h2>
<div class="marquee">
  <div class="marquee-track">
    <div class="marquee-set">
      {photos.map((p, i) => <button type="button" class="shot" data-i={i} data-full={p.full} aria-label={`Zs at the Gap photo ${i + 1} of ${photos.length}`}><Image src={p.src} alt="" width={600} /></button>)}
    </div>
    <div class="marquee-set" aria-hidden="true">
      {photos.map((p, i) => <button type="button" class="shot" tabindex="-1" data-i={i} data-full={p.full}><Image src={p.src} alt="" width={600} /></button>)}
    </div>
  </div>
</div></section>
<section id="contact" class="alt"><h2>Questions?</h2>
<p>Email us at <a href={`mailto:${event.contactEmail}`}>{event.contactEmail}</a></p>
<a class="btn" href={`mailto:${event.contactEmail}?subject=Zs%20at%20the%20Gap`}>Email Us</a>
<a class="btn btn-fb" href={event.facebookUrl} target="_blank" rel="noopener"><Fragment set:html={fbIcon} /> Join the Facebook group</a></section>
</main>
<footer>© {new Date().getFullYear()} {event.name} · zsatthegap.com · <a class="fb" href={event.facebookUrl} target="_blank" rel="noopener" aria-label="Facebook group" set:html={fbIcon} /></footer>
<div id="lightbox" class="lb" hidden role="dialog" aria-modal="true" aria-label="Gallery photo">
  <button type="button" class="lb-x" aria-label="Close">×</button>
  <button type="button" class="lb-prev" aria-label="Previous photo">‹</button>
  <button type="button" class="lb-next" aria-label="Next photo">›</button>
  <img id="lb-img" alt="" />
</div>
<script>
const el = document.getElementById('countdown')!; const t = new Date(el.dataset.date!).getTime();
const set = (id: string, v: number) => (document.getElementById(id)!.textContent = String(v).padStart(2, '0'));
function tick() { let x = Math.max(0, t - Date.now());
  if (x === 0) { el.innerHTML = '<p class="live">Engines on, it\'s go time!</p>'; return; }
  set('d', Math.floor(x / 864e5)); set('h', Math.floor(x / 36e5) % 24); set('m', Math.floor(x / 6e4) % 60); set('s', Math.floor(x / 1e3) % 60); setTimeout(tick, 1000); }
tick();
</script>
<script>
const marquee = document.querySelector('.marquee');
const lb = document.getElementById('lightbox');
const lbImg = document.getElementById('lb-img');
const fulls = [...document.querySelectorAll('.marquee-set:not([aria-hidden="true"]) .shot')].map((b) => ({
  src: b.dataset.full, alt: b.getAttribute('aria-label') || 'Zs at the Gap photo',
}));
let index = 0, lastFocus = null, sx = 0, sy = 0;
const focusable = () => [...lb.querySelectorAll('button:not([disabled])')];
function show() {
  const p = fulls[index];
  lbImg.src = p.src;
  lbImg.alt = p.alt;
  lb.setAttribute('aria-label', p.alt);
}
function openAt(i, opener) {
  if (!fulls.length) return;
  index = (i + fulls.length) % fulls.length;
  show();
  lastFocus = opener;
  lb.hidden = false;
  document.body.style.overflow = 'hidden';
  marquee.classList.add('is-paused');
  lb.querySelector('.lb-x').focus();
}
function closeLb() {
  if (lb.hidden) return;
  lb.hidden = true;
  document.body.style.overflow = '';
  marquee.classList.remove('is-paused');
  lbImg.removeAttribute('src');
  if (lastFocus) lastFocus.focus();
}
function step(d) { index = (index + d + fulls.length) % fulls.length; show(); }
marquee.addEventListener('click', (e) => {
  const btn = e.target.closest('.shot');
  if (!btn) return;
  const i = Number(btn.dataset.i);
  const visible = marquee.querySelector(`.marquee-set:not([aria-hidden="true"]) .shot[data-i="${i}"]`);
  openAt(i, visible || btn);
});
lb.querySelector('.lb-x').addEventListener('click', closeLb);
lb.querySelector('.lb-prev').addEventListener('click', () => step(-1));
lb.querySelector('.lb-next').addEventListener('click', () => step(1));
lb.addEventListener('click', (e) => { if (e.target === lb) closeLb(); });
lb.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') { e.preventDefault(); closeLb(); return; }
  if (e.key === 'ArrowRight') { e.preventDefault(); step(1); return; }
  if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); return; }
  if (e.key !== 'Tab') return;
  const items = focusable();
  if (!items.length) return;
  const first = items[0], last = items[items.length - 1];
  if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
  else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
});
lb.addEventListener('touchstart', (e) => { sx = e.changedTouches[0].clientX; sy = e.changedTouches[0].clientY; }, { passive: true });
lb.addEventListener('touchend', (e) => {
  const dx = e.changedTouches[0].clientX - sx, dy = e.changedTouches[0].clientY - sy;
  if (Math.abs(dx) < 48 || Math.abs(dx) < Math.abs(dy)) return;
  step(dx < 0 ? 1 : -1);
}, { passive: true });
</script>
<style is:global>
:root{--nismo:#C3002F;--nismo-hover:#ff2a55;--fg:#fff}
*{box-sizing:border-box}
body,section,.hero,section.alt{background:#000}
body{margin:0;font-family:system-ui,sans-serif;color:var(--fg);line-height:1.6}
a{color:var(--nismo)}a:hover{color:var(--nismo-hover)}
nav{position:sticky;top:0;z-index:9;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:.5rem;padding:.7rem 1.2rem;background:#000}
nav a{color:var(--fg);text-decoration:none;margin-left:1rem;font-weight:600}nav a:hover{color:var(--nismo)}
.brand{font-weight:900;font-size:1.3rem;margin:0}.brand span{color:var(--nismo)}
.banner{position:relative;background:#000;line-height:0}.banner img{display:block;width:100%;height:auto}
.banner::before,.banner::after{content:"";position:absolute;left:0;right:0;z-index:1;pointer-events:none}
.banner::before{top:0;height:min(24px,2%);background:linear-gradient(to bottom,rgba(0,0,0,.6),transparent)}
.banner::after{bottom:0;height:28%;background:linear-gradient(to bottom,transparent 0%,transparent 48%,rgba(0,0,0,.4) 70%,#000 100%)}
.hero{min-height:auto;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:3rem 1rem}
.hero h1{font-size:clamp(2.8rem,10vw,6rem);margin:.2rem 0;letter-spacing:.04em;font-weight:900;color:var(--nismo);text-shadow:0 3px 0 #000}
h2{color:var(--nismo)}
.kicker{text-transform:uppercase;letter-spacing:.3em;color:var(--nismo);font-size:.85rem}.tagline{max-width:640px;font-size:1.15rem;margin:.5rem auto}.when{font-size:1.3rem;font-weight:700}
.hero-mid{display:flex;align-items:center;gap:1.4rem;width:min(980px,100%);margin:.4rem auto .2rem;text-align:left}
.dragon,.us129{width:170px;height:auto;flex:none}
.hero-copy{min-width:0}.hero-copy p{margin:.3rem 0}.hero-copy .tagline{margin:.2rem 0 .4rem;max-width:none}
#countdown{display:flex;gap:.8rem;margin:1.5rem 0;flex-wrap:wrap;justify-content:center}#countdown div{background:#0008;border:2px solid var(--nismo);border-radius:10px;padding:.8rem;min-width:80px}
#countdown b{display:block;font-size:clamp(1.8rem,7vw,3rem);font-variant-numeric:tabular-nums;color:var(--nismo)}#countdown small{text-transform:uppercase;letter-spacing:.15em;font-size:.7rem;color:var(--fg)}
.live{font-size:2rem;font-weight:900;color:var(--nismo)}
.btn{display:inline-block;background:var(--nismo);color:#fff;font-weight:800;padding:.85rem 1.6rem;border-radius:999px;text-decoration:none;text-transform:uppercase;letter-spacing:.05em}
.btn:hover{background:var(--nismo-hover);color:#fff}
section{max-width:960px;margin:auto;padding:4rem 1.2rem}section.alt{max-width:none;text-align:center}
h2{font-size:2rem;text-transform:uppercase;border-left:6px solid var(--nismo);padding-left:.6rem;display:inline-block}
.marquee{position:relative;overflow:hidden;margin-top:1.5rem}
.marquee-track{display:flex;width:max-content;animation:marquee 35s linear infinite}
.marquee:hover .marquee-track,.marquee.is-paused .marquee-track{animation-play-state:paused}
.shot{padding:0;border:0;background:none;cursor:zoom-in;flex:none;line-height:0}
.lb{position:fixed;inset:0;z-index:50;display:flex;align-items:center;justify-content:center;background:#000e;padding:3.5rem 4.5rem}
.lb[hidden]{display:none}
.lb img{max-width:min(92vw,1600px);max-height:86vh;width:auto;height:auto;object-fit:contain}
.lb-x,.lb-prev,.lb-next{position:absolute;z-index:2;width:44px;height:44px;border:0;border-radius:999px;background:#000c;color:#fff;font-size:1.8rem;line-height:1;cursor:pointer}
.lb-x{top:1rem;right:1rem}.lb-prev{left:1rem;top:50%;transform:translateY(-50%)}.lb-next{right:1rem;top:50%;transform:translateY(-50%)}
.lb-x:hover,.lb-prev:hover,.lb-next:hover{color:var(--nismo)}
.lb-x:focus-visible,.lb-prev:focus-visible,.lb-next:focus-visible{outline:2px solid var(--nismo);outline-offset:2px}
.marquee-set{display:flex;gap:1rem;padding-right:1rem}
.marquee img{height:200px;width:auto;flex:none;border-radius:8px}
.marquee::before,.marquee::after{content:"";position:absolute;top:0;bottom:0;width:3.5rem;z-index:1;pointer-events:none}
.marquee::before{left:0;background:linear-gradient(to right,#000,transparent)}
.marquee::after{right:0;background:linear-gradient(to left,#000,transparent)}
@keyframes marquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.fb{display:inline-flex;vertical-align:middle}.btn-fb{background:#1877f2;color:#fff;display:inline-flex;align-items:center;gap:.5rem;margin:.5rem}
.btn-fb:hover{background:#0d65d9;color:#fff}
footer{text-align:center;padding:2rem;color:var(--fg);font-size:.9rem;background:#000a}
@media(max-width:600px){nav div a{margin-left:.6rem;font-size:.9rem}.hero-mid{flex-wrap:wrap;justify-content:center;gap:.75rem}.dragon,.us129{width:100px}.hero-copy{flex:1 1 100%;text-align:center}.hero-copy .tagline,.hero-copy p{text-align:center}.hero-copy .tagline{font-size:1rem}.marquee img{height:150px}}
@media(prefers-reduced-motion:reduce){.marquee-track{animation:none}.marquee{overflow-x:auto}.marquee-set[aria-hidden="true"]{display:none}.marquee::before,.marquee::after{display:none}}
</style>
</body></html>
